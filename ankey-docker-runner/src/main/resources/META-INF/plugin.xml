<idea-plugin>
    <id>docker-runner-plugin</id>
    <name>DockerRunnerPlugin</name>
    <vendor>uniclog</vendor>

    <!--
    <applicationListeners>
        <listener
                class="io.github.uniclog.docker.runner.Activator"
                topic="com.intellij.ide.AppLifecycleListener"/>
    </applicationListeners>
    -->

    <extensions defaultExtensionNs="com.intellij">
        <applicationService
                serviceImplementation="io.github.uniclog.docker.runner.settings.AnkeySettings"/>
        <toolWindow
                id="Docker Runner"
                anchor="bottom"
                factoryClass="io.github.uniclog.docker.runner.ui.DockerToolWindow"/>
    </extensions>

    <actions>
        <action id="RunPluginAction"
                class="io.github.uniclog.docker.runner.RunPluginAction"
                text="Ankey Docker Runner"
                description="">
            <add-to-group group-id="MainToolbarRight" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
